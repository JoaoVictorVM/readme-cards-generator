# All variables below are optional.
# The project installs, builds and runs with none of them set.

# GitHub personal access token. Raises the GitHub REST quota from 60 to 5000
# requests per hour. When absent, no Authorization header is sent.
GITHUB_TOKEN=

# Upstash Redis REST credentials used only by the rate limiter.
# When either is absent, rate limiting is disabled and the app fails open.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
